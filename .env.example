# App-wide primary operator login
ARIDON_APP_USERNAME=aridon-admin
ARIDON_APP_PASSWORD=replace-with-a-long-unique-password

# Optional secondary operator login. Set both values together or leave both blank.
ARIDON_APP_SECONDARY_USERNAME=
ARIDON_APP_SECONDARY_PASSWORD=

# Public production URL, with no trailing slash
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# AI draft generation and executive tools
OPENAI_API_KEY=

# Supabase customer + operator data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe paid customer subscriptions
# Create one recurring Price in Stripe for each package, then put the price_ IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_COMMAND=

# Gmail OAuth send + selected briefing read access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
