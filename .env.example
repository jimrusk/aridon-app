# App-wide primary operator login
ARIDON_APP_USERNAME=aridon-admin
ARIDON_APP_PASSWORD=replace-with-a-long-unique-password

# Optional secondary operator login. Set both values together or leave both blank.
ARIDON_APP_SECONDARY_USERNAME=
ARIDON_APP_SECONDARY_PASSWORD=

# Public production URL, with no trailing slash
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Daily Marketing Autopilot. Vercel Cron sends CRON_SECRET as a Bearer token.
CRON_SECRET=replace-with-a-long-random-secret
MARKETING_AUTOPILOT_TARGET_URL=https://your-project.vercel.app

# Optional marketing data connectors. Autopilot reports these as "ready" until configured.
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ACCESS_TOKEN=
INSTANTLY_API_KEY=

# AI draft generation and executive tools
OPENAI_API_KEY=
CUSTOMER_ASSISTANT_MODEL=gpt-5.6
CUSTOMER_SALES_MODEL=gpt-5.6

# Supabase customer + operator data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts each customer's optional third-party integration credential before storage.
# Use a long unique random secret and keep it server-only.
CUSTOMER_INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Sent.dm is Aridon's primary customer-messaging provider for SMS, WhatsApp and RCS.
# Keep the key server-side. SENT_PROFILE_ID is optional when the key already identifies the sender profile.
SENT_API_KEY=
SENT_PROFILE_ID=

# Voice calling is separate from messaging. Keep these only while Aridon uses Twilio for voice calls.
PHONE_CALL_SIGNING_SECRET=replace-with-a-long-random-secret
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe paid customer subscriptions
# Create one recurring Price in Stripe for each package, then put the price_ IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_COMMAND=

# Gmail OAuth send + selected briefing read access
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
