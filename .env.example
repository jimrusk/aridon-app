# App-wide primary login
ARIDON_APP_USERNAME=aridon-admin
ARIDON_APP_PASSWORD=replace-with-a-long-unique-password

# Optional secondary login. Set both values together or leave both blank.
ARIDON_APP_SECONDARY_USERNAME=
ARIDON_APP_SECONDARY_PASSWORD=

# Public production URL, with no trailing slash
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# AI draft generation
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail OAuth send-only connection
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
